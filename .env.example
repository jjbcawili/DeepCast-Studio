# Required: Google Gemini API key for podcast outlines and scripts.
GEMINI_API_KEY=""

# Required: ElevenLabs API key for voice previews and final podcast audio.
ELEVENLABS_API_KEY=""

# Optional: Override the default ElevenLabs voice IDs.
JIRO_ELEVENLABS_VOICE_ID="pe3VMth5BPRL0ZY3J9lc"
SHARPAY_ELEVENLABS_VOICE_ID="uC66YjdAMHXrcaX6MoXS"

# Optional: Public application URL for integrations and callbacks.
APP_URL="http://localhost:3000"

# Optional: Express server port. Defaults to 3000.
PORT="3000"
