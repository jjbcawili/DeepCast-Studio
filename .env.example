# DeepCast Studio environment template
# Never commit real secrets.

# Required for current text/script generation and Gemini TTS.
GEMINI_API_KEY=""

# Current source-sync defaults, verified against Google AI model docs on 2026-08-07.
GEMINI_TEXT_MODEL="gemini-3.6-flash"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"

# Optional server configuration.
PORT="3000"
APP_URL="http://localhost:3000"

# Optional integration surfaces. Keep real endpoints/secrets in deployment settings.
DRIVE_AUTH_URL=""
VITE_DRIVE_AUTH_URL=""
DEEPCAST_BACKEND_URL=""
